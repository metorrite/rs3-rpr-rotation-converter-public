{
  "name": "rs3-rpr-rotation-converter",
  "version": "0.1.0",
  "description": "Convert RuneScape 3 PvM ability rotations between RS Analysis, RotationMaster, and PVME-guide notation.",
  "type": "module",
  "private": true,
  "main": "dist/electron/main.js",
  "bin": {
    "rs3rot": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:all": "node scripts/clean.mjs --all",
    "rebuild": "npm run clean && npm run build && npm test",
    "build": "tsc && node scripts/copy-data.mjs",
    "samples": "npm run build && node scripts/make-samples.mjs",
    "cli": "tsx src/cli/index.ts",
    "gui": "npm run build && electron dist/electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "update-assets": "node scripts/update-assets.mjs",
    "fetch-guides": "node scripts/fetch-guides.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "build": {
    "appId": "com.drake.rsanalysis.rotationmaster.converter",
    "productName": "RSAnalysis to RotationMaster Converter",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "src/electron-ui/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
